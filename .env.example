# ---------------------------------------------------------------------------
# Flüsterchat – alle Werte sind optional, die Vorgaben passen für den Anfang.
# Kopieren nach .env und anpassen (oder direkt als Umgebungsvariablen setzen).
# ---------------------------------------------------------------------------

# Netzwerk
PORT=3000
HOST=0.0.0.0
# Auf 1 setzen, wenn ein Reverse Proxy (Apache, nginx, Caddy, Traefik) davorsteht.
# Sonst sehen alle Rate-Limits nur die IP des Proxys.
TRUST_PROXY=0

# Unterpfad, unter dem die App haengt. Leer = Wurzel.
# Fuer https://megamc.de/chats also: BASE_PATH=/chats
BASE_PATH=

# Wo Momentaufnahme und verschlüsselte Anhänge liegen.
DATA_DIR=./data

# Aufräumen
# Ein Chat verschwindet, wenn er so viele Stunden lang still war.
ROOM_IDLE_TTL_HOURS=168
# Ein Code, dem nie jemand beigetreten ist, verfällt schon früher.
UNCLAIMED_ROOM_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=5

# Grenzen
MAX_MESSAGES_PER_ROOM=5000
MAX_CIPHERTEXT_BYTES=65536
MAX_BLOB_BYTES=12582912
MAX_ROOM_BLOB_BYTES=157286400
MAX_SOCKETS_PER_MEMBER=4
# Wie gross eine Gruppe hoechstens werden darf (der Anleger zaehlt mit).
MAX_ROOM_CAPACITY=16

# Rate-Limits (pro IP bzw. pro Mitglied)
CREATE_ROOM_PER_HOUR=60
JOIN_ATTEMPTS_PER_HOUR=300
# Die Uebersicht auf der Startseite fragt alle paar Sekunden nach.
OVERVIEW_PER_HOUR=5000
UPLOADS_PER_HOUR=400
MESSAGES_PER_MINUTE=240

# silent | error | warn | info | debug
LOG_LEVEL=info
