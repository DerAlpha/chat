# ---------------------------------------------------------------------------
# Flüsterchat auf klassischem Webspace (lima-city & Co.)
# Diese Datei gehört in das Wurzelverzeichnis der Seite.
# ---------------------------------------------------------------------------

DirectoryIndex index.html

# Hinweis: Die Symbole der App liegen in img/ und nicht in icons/. Apache
# bringt vielerorts ein "Alias /icons/" auf sein eigenes Symbolverzeichnis
# mit, das einen gleichnamigen Ordner im Webverzeichnis verdeckt.

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml            .svg
</IfModule>

<IfModule mod_headers.c>
    # Genau dieselbe Absicherung wie beim Node-Server: keine fremden Quellen,
    # keine eingebetteten Skripte, kein Einbetten in fremde Seiten.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "DENY"
    # Kamera und Mikrofon ausdrücklich nur für die eigene Seite: Anrufe
    # brauchen beides, eingebettete Fremdinhalte gibt es hier ohnehin nicht.
    Header always set Permissions-Policy "camera=(self), microphone=(self), display-capture=(), geolocation=(), payment=(), interest-cohort=()"
    # Dieselben zwei wie beim Node-Server - sie fehlten hier und waren damit
    # eine stille Abweichung zwischen den beiden Auslieferungen.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # Nur wenn die Anfrage wirklich über HTTPS kam: über eine unverschlüsselte
    # Verbindung ist die Zusage wertlos, und auf einem Testserver ohne
    # Zertifikat sperrte sie den Zugang aus.
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# Gepackt ausliefern - dasselbe, was der Node-Server tut. Ohne das gehen
# Quelltext und Stilblatt in voller Laenge ueber die Leitung; gepackt bleibt
# knapp ein Viertel davon. Bilder und Anhaenge sind schon gepackt und werden
# bewusst ausgelassen.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Wichtig, wenn die App NICHT im Wurzelverzeichnis liegt: hier den
    # Unterordner eintragen, z. B. "RewriteBase /chat/". Ohne diese Angabe
    # löst Apache relative Ziele gegen den Dateisystempfad auf und leitet
    # in den Nirgendwo um.
    RewriteBase /

    # Die API regelt sich selbst.
    RewriteRule ^api/ - [L]

    # Vorhandene Dateien und Ordner unverändert ausliefern.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alles Übrige zurück auf die Startseite. Umleiten statt index.html
    # ausliefern: die Seite lädt ihre Dateien relativ, von einem tieferen
    # Pfad aus zeigten die Verweise sonst ins Leere.
    RewriteRule ^ ./ [R=302,L]
</IfModule>

<IfModule mod_headers.c>
    # Die App-Hülle darf nicht kleben bleiben, sonst kommen Aktualisierungen nie an.
    <FilesMatch "\.(html|js|css|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(png|svg|ico|woff2)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Verstecktes bleibt versteckt.
<FilesMatch "^\.">
    Require all denied
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
